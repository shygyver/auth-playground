{
  "name": "auth-playground",
  "version": "0.1.0",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.12",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.3",
    "turbo": "^2.9.7",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "turbo run build",
    "build:oidc-app": "turbo run build --filter=oidc-app",
    "build:oidc-persistent-app": "turbo run build --filter=oidc-persistent-app",
    "build:oidc-consent-app": "turbo run build --filter=oidc-consent-app",
    "build:oidc-refresh-app": "turbo run build --filter=oidc-refresh-app",
    "check": "turbo run check",
    "check:oidc-app": "turbo run check --filter=oidc-app",
    "check:oidc-persistent-app": "turbo run check --filter=oidc-persistent-app",
    "check:oidc-consent-app": "turbo run check --filter=oidc-consent-app",
    "check:oidc-refresh-app": "turbo run check --filter=oidc-refresh-app",
    "dev": "turbo run dev --filter=!oidc-persistent-app",
    "dev:oidc-app": "turbo run dev --filter=oidc-app",
    "dev:oidc-persistent-app": "turbo run dev --filter=oidc-persistent-app",
    "dev:oidc-consent-app": "turbo run dev --filter=oidc-consent-app",
    "dev:oidc-refresh-app": "turbo run dev --filter=oidc-refresh-app",
    "fmt": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --write ./",
    "fmt:staged": "cross-env NODE_OPTIONS=--experimental-strip-types lint-staged"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*"
  ]
}